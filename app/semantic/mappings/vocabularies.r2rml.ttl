# R2RML: lookup tables as SKOS concept schemes (one scheme per table).
# {{BASE}} is replaced by the base IRI (setting SEMANTIC_ENV). Concepts are
# {{BASE}}concept/<scheme>/<code>; the schemes themselves are described in
# ../data/concept-schemes.ttl. Every concept is exported; the JSON-LD
# document only keeps the ones a project refers to.

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bfx: <{{BASE}}ext#> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .

<#NbsTypeConcepts> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery """SELECT code, name, description FROM case_data.nbs_types""" ] ;
  rr:subjectMap [ rr:template "{{BASE}}concept/nbs-type/{code}" ; rr:class skos:Concept ] ;
  rr:predicateObjectMap [ rr:predicate skos:prefLabel ; rr:objectMap [ rr:column "name" ; rr:language "en" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:definition ; rr:objectMap [ rr:column "description" ; rr:language "en" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:notation ; rr:objectMap [ rr:column "code" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:inScheme ; rr:object <{{BASE}}concept/nbs-type> ] .

