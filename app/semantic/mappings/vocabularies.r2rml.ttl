<#BngHabitatTypeConcepts> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery """SELECT code, name, description, category, distinctiveness, distinctiveness_score::text AS distinctiveness_score FROM case_data.bng_habitat_types""" ] ;
  rr:subjectMap [ rr:template "{{BASE}}concept/bng-habitat-type/{code}" ; rr:class skos:Concept ] ;
  rr:predicateObjectMap [ rr:predicate skos:prefLabel ; rr:objectMap [ rr:column "name" ; rr:language "en" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:definition ; rr:objectMap [ rr:column "description" ; rr:language "en" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:notation ; rr:objectMap [ rr:column "code" ] ] ;
  rr:predicateObjectMap [ rr:predicate bfx:habitatCategory ; rr:objectMap [ rr:column "category" ] ] ;
  rr:predicateObjectMap [ rr:predicate bfx:distinctiveness ; rr:objectMap [ rr:column "distinctiveness" ] ] ;
  rr:predicateObjectMap [ rr:predicate bfx:distinctivenessScore ; rr:objectMap [ rr:column "distinctiveness_score" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:inScheme ; rr:object <{{BASE}}concept/bng-habitat-type> ] .

