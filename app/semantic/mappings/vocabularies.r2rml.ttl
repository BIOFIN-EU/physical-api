# Currencies: ISO 4217 codes, matched to the EU Publications Office currency list.
<#CurrencyConcepts> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery """SELECT code, name FROM case_data.currencies""" ] ;
  rr:subjectMap [ rr:template "{{BASE}}concept/currency/{code}" ; rr:class skos:Concept ] ;
  rr:predicateObjectMap [ rr:predicate skos:prefLabel ; rr:objectMap [ rr:column "name" ; rr:language "en" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:notation ; rr:objectMap [ rr:column "code" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:exactMatch ; rr:objectMap [ rr:template "http://publications.europa.eu/resource/authority/currency/{code}" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:inScheme ; rr:object <{{BASE}}concept/currency> ] .

# Countries: ISO 3166 alpha-2 codes, matched to the EU Publications Office
# country list (alpha-3 codes). Countries without an entry below (Kosovo,
# "Multiple Countries") get no match. Add a row to the VALUES list for a new
# country.
<#CountryConcepts> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery """
    SELECT c.code, c.name, m.iso3
    FROM case_data.countries c
    LEFT JOIN (VALUES
      ('AD','AND'),('AL','ALB'),('AT','AUT'),('BA','BIH'),('BE','BEL'),('BG','BGR'),('BR','BRA'),
      ('BY','BLR'),('CH','CHE'),('CY','CYP'),('CZ','CZE'),('DE','DEU'),('DK','DNK'),('EE','EST'),
      ('ES','ESP'),('FI','FIN'),('FR','FRA'),('GB','GBR'),('GI','GIB'),('GR','GRC'),('HR','HRV'),
      ('HU','HUN'),('IE','IRL'),('IS','ISL'),('IT','ITA'),('LI','LIE'),('LT','LTU'),('LU','LUX'),
      ('LV','LVA'),('MC','MCO'),('MD','MDA'),('ME','MNE'),('MK','MKD'),('MT','MLT'),('NL','NLD'),
      ('NO','NOR'),('PL','POL'),('PT','PRT'),('RO','ROU'),('RS','SRB'),('RU','RUS'),('SE','SWE'),
      ('SI','SVN'),('SK','SVK'),('SM','SMR'),('UA','UKR'),('VA','VAT')
    ) AS m(iso2, iso3) ON m.iso2 = c.code
  """ ] ;
  rr:subjectMap [ rr:template "{{BASE}}concept/country/{code}" ; rr:class skos:Concept ] ;
  rr:predicateObjectMap [ rr:predicate skos:prefLabel ; rr:objectMap [ rr:column "name" ; rr:language "en" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:notation ; rr:objectMap [ rr:column "code" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:exactMatch ; rr:objectMap [ rr:template "http://publications.europa.eu/resource/authority/country/{iso3}" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:inScheme ; rr:object <{{BASE}}concept/country> ] .

# Pathways: one concept per workflow definition (code from workflows.json).
<#PathwayConcepts> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery """SELECT DISTINCT code FROM workflow.workflow_definitions""" ] ;
  rr:subjectMap [ rr:template "{{BASE}}concept/pathway/{code}" ; rr:class skos:Concept ] ;
  rr:predicateObjectMap [ rr:predicate skos:notation ; rr:objectMap [ rr:column "code" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:prefLabel ; rr:objectMap [ rr:column "code" ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:inScheme ; rr:object <{{BASE}}concept/pathway> ] .
